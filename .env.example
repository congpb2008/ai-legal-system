# ==============================================================================
# Legal Knowledge Platform — Environment Configuration
# ==============================================================================

# Server Network Configuration
LEGAL_PLATFORM_HOST=0.0.0.0
LEGAL_PLATFORM_PORT=8080
# Native source runs resolve this path relative to the repository. Docker
# overrides it to /app/storage and bind-mounts LEGAL_PLATFORM_HOST_DATA_DIR.
LEGAL_PLATFORM_DATA_DIR=./storage
LEGAL_PLATFORM_HOST_DATA_DIR=./storage

# Remote AI / Ollama Model Server Configuration
# External Ollama endpoint (leave unbundled, accessed over network). Replace
# OLLAMA_API_KEY in a private .env if your remote provider requires a secret.
OLLAMA_BASE_URL=https://my-container-4vsbn24p-11434.serverless.fptcloud.jp
OLLAMA_API_KEY=ollama

# Model Configuration
GENERATION_MODEL=qwen3.6:35b-a3b
EMBEDDING_MODEL=bge-m3:567m-fp16
LEGAL_PLATFORM_GENERATION_TIMEOUT=120
LEGAL_PLATFORM_GENERATION_REASONING_EFFORT=none
