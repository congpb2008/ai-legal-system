# Server Network Configuration
LEGAL_PLATFORM_HOST=0.0.0.0
LEGAL_PLATFORM_PORT=8080
LEGAL_PLATFORM_DATA_DIR=/app/storage

# Remote AI / Ollama Model Server Configuration
