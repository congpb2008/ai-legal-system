# Optional source/Docker configuration. Local search works without an AI provider.
LEGAL_PLATFORM_HOST=0.0.0.0
LEGAL_PLATFORM_PORT=8080
LEGAL_PLATFORM_DATA_DIR=./storage
LEGAL_PLATFORM_HOST_DATA_DIR=./storage
LEGAL_PLATFORM_STORAGE_LIMIT_MB=2048
# Configure AI in the administrator's Server settings screen after setup.
# No document or question is sent to an AI provider by default.

# Hosted Compose only: real hostname without scheme or path.
# LEGAL_PLATFORM_DOMAIN=library.example.com
# Override these together only if the default Docker network conflicts.
# LEGAL_PLATFORM_PROXY_SUBNET=172.30.84.0/24
# LEGAL_PLATFORM_PROXY_ADDRESS=172.30.84.2
# For a custom reverse proxy, set the application environment explicitly:
# LEGAL_PLATFORM_PUBLIC_ORIGIN=https://library.example.com
# LEGAL_PLATFORM_TRUSTED_PROXIES=192.0.2.10/32
